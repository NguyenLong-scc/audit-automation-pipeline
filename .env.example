# Keep this file free of real credentials. Copy it to .env for local use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CRITIC_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Optional read-only GitHub token for higher public API rate limits.
GITHUB_TOKEN=

# Local PostgreSQL. Replace this with the managed provider URL in production.
DATABASE_URL=postgresql:///audit_warehouse

# Legacy presentation-only SQLite path.
WAREHOUSE_DB_PATH=data/learning_warehouse.sqlite3

# Local presentation-only AI intake gateway.
GATEWAY_DB_PATH=data/ingestion_gateway.sqlite3

# Client-submitted document storage (audit_agent/document_storage.py). Defaults to a
# local folder so this works with no cloud account. Set to "s3" to use any
# S3-compatible object store (Viettel Cloud Storage, VNG Cloud, AWS S3, MinIO...) —
# only these environment variables change, no code changes needed.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_LOCAL_DIR=data/documents
# DOCUMENT_STORAGE_BACKEND=s3
# DOCUMENT_STORAGE_ENDPOINT_URL=
# DOCUMENT_STORAGE_BUCKET=
# DOCUMENT_STORAGE_ACCESS_KEY=
# DOCUMENT_STORAGE_SECRET_KEY=
